# Variabel khusus Docker Compose. Salin menjadi .env di folder ini (tidak ikut git).
# Rahasia backend (database, WhatsApp, AI, JWT) TIDAK di sini, tapi di backend/.env (contoh: backend/.env.example).

# Alamat publik situs, dipakai untuk sitemap dan metadata. Kosong = bawaan di frontend/lib/site-config.ts.
# Dikunci saat build web: ganti nilainya lalu `docker compose up -d --build web`.
SITE_URL=

# Port web di server ini. Bawaan 3000.
WEB_PORT=3000
# 127.0.0.1 = hanya dari server ini (aman, bawaan). 0.0.0.0 = bisa dibuka dari HP/laptop lain di jaringan rumah.
WEB_BIND=127.0.0.1

# Token Cloudflare Tunnel (dashboard Cloudflare > Zero Trust > Networks > Tunnels). Hanya untuk `--profile public`. Rahasia.
TUNNEL_TOKEN=
