PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/pitstop
DATABASE_SSL=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
COOKIE_SECURE=false
FONNTE_TOKEN=replace-with-your-fonnte-api-token

# Required only when creating the first owner account with `npm run db:bootstrap-owner`.
BOOTSTRAP_OWNER_NAME=Owner PitStop
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=change-this-to-a-long-unique-password
