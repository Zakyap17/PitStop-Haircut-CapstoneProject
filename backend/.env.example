# Port dan alamat yang didengarkan server.
PORT=4000
HOST=0.0.0.0

# PostgreSQL (Supabase / Neon). Tanpa ini, server memakai database tertanam (PGlite) yang cocok untuk dev saja.
# Contoh Neon:     postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Contoh Supabase: postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Folder penyimpanan database tertanam (hanya dipakai kalau DATABASE_URL kosong). Kosong = data hilang saat berhenti.
PGLITE_DIR=.data/pglite

# Asal (origin) web yang boleh memanggil API langsung dari browser, pisahkan dengan koma. Kosong = semua.
# Kalau web memakai proxy Next (/api -> backend), ini tidak wajib.
CORS_ORIGINS=

# Isi kalau backend ada di belakang proxy/reverse proxy (Nginx, Cloudflare Tunnel, Tailscale Funnel):
# jumlah proxy (contoh 1) atau "true". Dipakai agar batas percobaan per alamat IP benar.
TRUST_PROXY=

# Batas percobaan per alamat IP (bawaan 30 pembuatan reservasi/menit dan 100 cek/ubah/batal per 15 menit).
# Kalau web memakai proxy Next, backend melihat semua pengunjung sebagai satu IP; naikkan angka ini kalau penguji saling terblokir.
RATE_LIMIT_WRITE=
RATE_LIMIT_ACCESS=

# WhatsApp otomatis (invoice saat reservasi dibuat, kabar ubah/batal, pengingat sebelum jadwal).
# console = hanya mencetak pesan di log (aman untuk dev). fonnte = kirim sungguhan lewat https://fonnte.com
WHATSAPP_PROVIDER=console
# Token perangkat dari dashboard Fonnte (wajib kalau WHATSAPP_PROVIDER=fonnte). Rahasia, jangan di-commit.
FONNTE_TOKEN=
# Alamat publik web customer, untuk tautan di pesan WhatsApp. Contoh: https://pitstop.example.com
PUBLIC_WEB_URL=

# Migrasi otomatis saat backend start. Hanya berlaku untuk database tertanam. Untuk database bersama jalankan `npm run migrate`
# secara sengaja; isi true hanya kalau kamu memang mau backend menjalankan migrasi sendiri.
AUTO_MIGRATE=

# Virtual Try-On AI (ganti gaya rambut di foto pelanggan). Kosongkan TRYON_API_KEY = fitur belum aktif.
# TRYON_PROVIDER: gemini (bawaan, kunci dari https://aistudio.google.com/apikey), openai (https://platform.openai.com/api-keys),
# atau openrouter (https://openrouter.ai/keys; analisa wajah pakai model gratis, pemasangan gaya butuh saldo kredit).
# TRYON_API_KEY rahasia, jangan di-commit. TRYON_MODEL = model pemasangan gaya, TRYON_ANALYSIS_MODEL = model analisa wajah; keduanya opsional
# (bawaan gemini: gemini-2.5-flash-image / gemini-2.5-flash, openai: gpt-image-1 / gpt-4.1-mini, openrouter: bytedance-seed/seedream-4.5 / google/gemma-4-31b-it:free).
TRYON_PROVIDER=gemini
TRYON_API_KEY=
TRYON_MODEL=
TRYON_ANALYSIS_MODEL=
# false = mode analisa saja: AI hanya menganalisa wajah dan merekomendasikan gaya (bisa gratis), tanpa memasang gaya di foto.
# Kosongkan atau true untuk juga memasang gaya di foto (butuh model gambar berbayar).
TRYON_GENERATE_IMAGE=
# Batas try-on per alamat IP per 10 menit (bawaan 20). Tiap try-on memakai kuota berbayar di penyedia AI.
TRYON_RATE_LIMIT=

# OTP WhatsApp: pemesan memasukkan kode 6 digit yang dikirim ke WhatsApp-nya sebelum booking dibuat (membuktikan nomornya milik pemesan).
# Bawaan menyala. Isi false untuk mematikan (mis. demo tanpa kuota WhatsApp). Tiap kode memakai satu pesan WhatsApp.
OTP_REQUIRED=
# Rahasia untuk hash kode OTP di database. Kosong = acak setiap backend menyala (aman; kode yang sedang beredar ikut tidak berlaku).
OTP_SECRET=
# Batas permintaan kode per alamat IP per 10 menit (bawaan 20). Per nomor sudah dibatasi: jeda 60 detik dan 3 kali per 10 menit.
OTP_RATE_LIMIT=

# --- Web internal (Admin, Capster, Owner): rute /api/internal ---
# Rahasia penanda tanda masuk (JWT). Wajib untuk login internal; tanpa ini /api/internal/auth/login membalas 503.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))". Jangan di-commit.
JWT_SECRET=
# Alamat web yang boleh mengirim permintaan tulis ke /api/internal, pisahkan dengan koma. Isi alamat yang dipakai di browser
# (contoh: http://localhost:3000,http://192.168.8.118:3000,https://pitstop.example.com). Bawaan hanya http://localhost:3000.
FRONTEND_ORIGIN=http://localhost:3000
# true kalau koneksi database butuh SSL tanpa verifikasi sertifikat (beberapa penyedia). Supabase pooler biasanya false.
DATABASE_SSL=false
# true hanya kalau web internal dibuka lewat HTTPS; cookie login jadi Secure dan SameSite=None.
COOKIE_SECURE=false
# Hanya untuk membuat akun owner pertama: npm run db:bootstrap-owner. Hapus lagi setelah dipakai.
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
